# Supabase Configuration
# Copy this file to `.env` and fill in the values from your Supabase project:
# Dashboard -> Project Settings -> API. The URL and key MUST belong to the
# same project. Use the public/anon or publishable key - never a service-role
# or secret key in the mobile client.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-or-publishable-key

# Optional alias (also supported by the client):
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
